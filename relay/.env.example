# --- Relay ---
PORT=3000
# Shared secret the Salesforce Named Credential sends as "Authorization: Bearer <token>"
RELAY_API_TOKEN=change-me

# --- Ring ---
RING_API_BASE=https://api.amazonvision.com
# Playground tokens are valid for 30 minutes; paste a fresh one before a demo.
RING_ACCESS_TOKEN=
# Secret used to verify the X-Signature header on incoming webhooks (and by the emulator to sign).
RING_WEBHOOK_SECRET=
# Poll Event History every N seconds (0 disables). Useful because the Playground sends no webhooks.
RING_POLL_INTERVAL_SECONDS=0

# --- Salesforce (JWT bearer flow, dedicated integration user) ---
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=
SF_USERNAME=
# Either the PEM itself (newlines as \n) or a path to the key file.
SF_PRIVATE_KEY=
SF_PRIVATE_KEY_PATH=
SF_API_VERSION=62.0
# Leave empty to run without Salesforce: events are logged instead of published.
